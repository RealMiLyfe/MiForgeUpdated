# ═══════════════════════════════════════════════════════════════
# MiForge Platform — Environment Configuration
# Agent writes this on first boot. Humans never touch it.
# ═══════════════════════════════════════════════════════════════

# ── GROUP A: NO CARD, NO PHONE (Pure Email Signup) ──
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GITHUB_TOKEN=
COHERE_API_KEY=

# ── GROUP B: EMAIL + PHONE (One-Time, No Card) ──
NVIDIA_API_KEY=
MISTRAL_API_KEY=

# ── GROUP C: REGION-SPECIFIC (Optional) ──
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=

# ── LOCAL MODELS (No Key Needed) ──
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ── MEMORY STACK ──
REDIS_URL=redis://localhost:6379
KUZU_URL=bolt://localhost:7474
MEM0_API_KEY=

# ── SAFETY GATES ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HUMAN_APPROVAL_TIMEOUT=300

# ── OBSERVABILITY ──
PHOENIX_URL=http://localhost:6006
BRAINTRUST_API_KEY=

# ── PROXY CONFIG ──
FCC_PORT=8082
LITELLM_PORT=4000
HYDRA_PORT=8083

# ═══════════════════════════════════════════════════════════════
# GOLDEN RULES:
# 1. NO CREDIT CARD keys here — ever.
# 2. All keys are permanent free tier only.
# 3. Agent auto-fills via provider_autoconfig on boot.
# ═══════════════════════════════════════════════════════════════
