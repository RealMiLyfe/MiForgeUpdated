# ═══════════════════════════════════════════════════════════════
# MiForge Harness: Aider (paul-gauthier/aider)
# Git-native coding agent. 44.9K stars. Apache-2.0.
#
# Usage: source harnesses/aider.env && aider
# Or:    aider --model openai/nvidia/nemotron-3-super-120b-a12b
# ═══════════════════════════════════════════════════════════════

# ── Route through LiteLLM proxy (all free providers behind one endpoint) ──
OPENAI_API_BASE=http://localhost:4000/v1
OPENAI_API_KEY=miforge-local-dev

# ── Or route directly to NVIDIA NIM (no proxy needed) ──
# OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=${NVIDIA_API_KEY}

# ── Model Selection ──
# Via proxy (uses LiteLLM model names → routes to free providers):
AIDER_MODEL=openai/claude-sonnet-4-5
AIDER_EDITOR_MODEL=openai/claude-haiku-4-5

# ── Direct NVIDIA NIM (alternative — no proxy required): ──
# AIDER_MODEL=openai/nvidia/nemotron-3-super-120b-a12b
# AIDER_EDITOR_MODEL=openai/nvidia/nemotron-3-super-120b-a12b

# ── Aider Settings ──
AIDER_AUTO_COMMITS=true
AIDER_DARK_MODE=true
AIDER_STREAM=true
AIDER_GIT=true
