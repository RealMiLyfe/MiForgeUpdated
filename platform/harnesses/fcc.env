# ═══════════════════════════════════════════════════════════════
# MiForge Harness: free-claude-code (alishahryar1/free-claude-code)
# The primary agent harness. 9,833+ stars. MIT license.
#
# Usage: source harnesses/fcc.env && fcc-server
# Admin: http://127.0.0.1:8082/admin
# ═══════════════════════════════════════════════════════════════

# ── Model Routing (Tier → Free Provider) ──
MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
MODEL_OPUS=nvidia_nim/moonshotai/kimi-k2-thinking
MODEL_SONNET=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
MODEL_HAIKU=groq/llama-3.3-70b-versatile

# ── Provider Keys (all free tier, no credit card) ──
NVIDIA_API_KEY=${NVIDIA_API_KEY}
GROQ_API_KEY=${GROQ_API_KEY}
GEMINI_API_KEY=${GEMINI_API_KEY}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

# ── Thinking Mode (maps <think> to Claude thinking blocks) ──
ENABLE_THINKING=true

# ── Rate Limiting ──
PROVIDER_MAX_CONCURRENCY=3
RATE_LIMIT_RPM=30

# ── Voice (optional — NVIDIA Parakeet STT, free) ──
WHISPER_MODEL=nvidia/parakeet-ctc-1.1b-asr

# ── Server Config ──
PORT=8082
HOST=127.0.0.1
LOG_LEVEL=info

# ── Fallback Chain ──
FALLBACK_OPUS=openrouter/openrouter/auto
FALLBACK_SONNET=groq/llama-3.3-70b-versatile
FALLBACK_HAIKU=ollama/qwen3-coder:latest
