# ═══════════════════════════════════════════════════════════════
# MiForge Harness: OpenCode
# Provider-agnostic CLI agent. MIT license. npm i -g opencode.
#
# Usage: source harnesses/opencode.env && opencode
# ═══════════════════════════════════════════════════════════════

# ── Route through LiteLLM proxy ──
OPENAI_API_BASE=http://localhost:4000/v1
OPENAI_API_KEY=miforge-local-dev

# ── Or direct to NVIDIA NIM ──
# OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=${NVIDIA_API_KEY}

# ── Model (proxy translates to free provider) ──
OPENCODE_MODEL=claude-sonnet-4-5

# ── Provider-specific direct configs (pick one) ──
# NVIDIA NIM direct:
# OPENCODE_PROVIDER=openai
# OPENCODE_MODEL=nvidia/nemotron-3-super-120b-a12b
# OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=${NVIDIA_API_KEY}

# Groq direct (fast):
# OPENCODE_PROVIDER=openai
# OPENCODE_MODEL=llama-3.3-70b-versatile
# OPENAI_API_BASE=https://api.groq.com/openai/v1
# OPENAI_API_KEY=${GROQ_API_KEY}

# Ollama local (private, unlimited):
# OPENCODE_PROVIDER=openai
# OPENCODE_MODEL=qwen3-coder:latest
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
